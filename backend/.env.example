# AgentSupport AI Environment Configuration
DATABASE_URL=sqlite:///./novacart.db

# LLM Configuration (Set provider to 'local' for zero-config deterministic engine or 'openai' for cloud API)
LLM_PROVIDER=local
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Agent Thresholds
CONFIDENCE_THRESHOLD=0.75
MAX_REPLAN_CYCLES=5
