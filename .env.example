# ==============================================================================
# SupportOS AI - Production Environment Configuration Template
# Copy this file to .env and configure values for your deployment environment.
# DO NOT COMMIT REAL CREDENTIALS OR API KEYS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & NETWORKING
# ------------------------------------------------------------------------------
ENVIRONMENT=production                # options: development, staging, production
DEBUG=false                           # must be false in production
LOG_LEVEL=INFO                        # options: DEBUG, INFO, WARNING, ERROR, CRITICAL
HOST=0.0.0.0
PORT=8000

# Comma-separated list of allowed CORS origins (do NOT use * in production)
ALLOWED_ORIGINS=https://support.novacart.com,https://admin.supportos.ai

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# SQLite (default for development/embedded):
DATABASE_URL=sqlite:///./novacart.db

# PostgreSQL (recommended for production scale):
# DATABASE_URL=postgresql://supportos_user:your_secure_password_here@postgres.internal.net:5432/supportos_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT & RBAC)
# ------------------------------------------------------------------------------
# Minimum 32-character high-entropy secret key for JWT signing
JWT_SECRET_KEY=change_this_to_a_secure_random_64_char_hex_string_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting Guardrails
RATE_LIMIT_PER_MINUTE=120

# ------------------------------------------------------------------------------
# 4. LLM & AI PROVIDER CONFIGURATION
# ------------------------------------------------------------------------------
# Provider: openai, groq, openrouter, or local (falls back to deterministic agent engine)
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-openai-or-groq-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.2
LLM_REQUEST_TIMEOUT_SECONDS=30

# ------------------------------------------------------------------------------
# 5. VECTOR STORE & RAG KNOWLEDGE BASE
# ------------------------------------------------------------------------------
VECTOR_STORE_BACKEND=memory          # options: memory, chroma, pgvector
EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_BASE_DIR=./data/policies

# ------------------------------------------------------------------------------
# 6. ACTION GATEWAY & FINANCIAL SAFETY LIMITS
# ------------------------------------------------------------------------------
# Maximum autonomous single-transaction refund cap (in USD)
AUTO_REFUND_LIMIT=500.00
# Require two-person supervisor review for transactions exceeding this amount
SUPERVISOR_APPROVAL_THRESHOLD=500.00
# Require executive / fraud team review for critical transactions
EXECUTIVE_APPROVAL_THRESHOLD=1500.00

# ------------------------------------------------------------------------------
# 7. OBSERVABILITY & TELEMETRY
# ------------------------------------------------------------------------------
ENABLE_PROMETHEUS_METRICS=true
METRICS_PORT=9090
TRACE_SAMPLE_RATE=1.0                # 0.0 to 1.0 (1.0 = 100% of traces captured)
SENSITIVE_DATA_REDACTION=true        # Masks credit cards, emails, tokens in logs

# ------------------------------------------------------------------------------
# 8. OMNICHANNEL, TELEPHONY & WEBHOOK SECRETS
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
GEMINI_API_KEY=your_gemini_api_key_here

# Telephony Configuration (Twilio / Mock)
AGENT_KAVIN_PHONE=+18005550101
AGENT_ROHAN_PHONE=+18005550102
AGENT_NARAHARI_PHONE=+18005550103
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_CALLER_ID=+18005550199

# E-commerce Store Webhook Secrets (HMAC verification)
SHOPIFY_WEBHOOK_SECRET=shpss_your_shopify_secret_token
WOOCOMMERCE_WEBHOOK_SECRET=wc_secret_hash_key_here
EMAIL_WEBHOOK_SECRET=your_email_inbound_hmac_secret_here
WHATSAPP_WEBHOOK_SECRET=your_meta_whatsapp_verification_token_here
PARTNER_API_KEY_HEADER=X-Partner-API-Key
